---
import { skills } from '../data/profile';
---

<section id="skills" class="section reveal">
  <h2><span class="mono num">04</span> Toolbox</h2>
  <dl class="skills">
    {skills.map((s) => (
      <div>
        <dt class="mono">{s.group}</dt>
        <dd><ul class="tags">{s.items.map((i) => <li>{i}</li>)}</ul></dd>
      </div>
    ))}
  </dl>
</section>
