---
import { profile } from '../data/profile';
const { links } = profile;
const social = [
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'GitHub', href: links.github },
  { label: 'YouTube', href: links.youtube },
  { label: 'TikTok', href: links.tiktok },
  { label: 'The Beehive', href: links.newsletter },
].filter((s) => s.href);
---

<section id="contact" class="section contact reveal">
  <h2><span class="mono num">06</span> Get in touch</h2>
  <p class="lede">Hiring for growth, behavioral, or product data science? Or just want to talk internships? My inbox is open.</p>
  {links.email && <a class="btn primary big" href={`mailto:${links.email}`}>{links.email}</a>}
  <ul class="social">
    {social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
  </ul>
</section>

<footer class="footer mono">
  © {new Date().getFullYear()} {profile.name} · Built with Astro
</footer>
