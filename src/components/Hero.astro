---
import { profile, highlights } from '../data/profile';
const first = profile.name.split(' ')[0];
const { links } = profile;
---

<section id="top" class="hero">
  <div class="hero-text">
    <p class="mono eyebrow"><span class="dot"></span> Now: {profile.now}</p>
    <h1>Hi, I'm {first}.</h1>
    <p class="lede">{profile.headline}</p>
    <p class="muted">{profile.role} · {profile.location}</p>
    <div class="cta">
      {links.email && <a class="btn primary" href={`mailto:${links.email}`}>Say hi</a>}
      {links.linkedin && <a class="btn" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
      {links.github && <a class="btn" href={links.github} target="_blank" rel="noopener">GitHub</a>}
      {links.resume && <a class="btn" href={links.resume} target="_blank" rel="noopener">Résumé</a>}
    </div>
  </div>
  <img class="headshot" src={`${import.meta.env.BASE_URL}/me.jpg`.replace('//', '/')} alt={`Photo of ${profile.name}`} width="240" height="240" />
</section>

<ul class="highlights reveal">
  {highlights.map((h) => (
    <li><strong>{h.value}</strong><span>{h.label}</span></li>
  ))}
</ul>
